# Адрес Go-бэкенда (../backend) для разработки. Скопируй в .env.local.
# Сборки EAS (preview/production) берут адрес сервера на ПК из eas.json → build.*.env.
# В Expo web и эмуляторе iOS подойдёт localhost; эмулятор Android — http://10.0.2.2:8080;
# телефон в той же Wi-Fi сети — http://<IP компьютера>:8080 (сервер запускать с CARDLESSON_ADDR=:8080).
EXPO_PUBLIC_API_URL=http://localhost:8080

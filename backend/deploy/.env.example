# Скопируй в .env (chmod 600) и заполни. Файл .env в git не попадает.

# Домен API, на который указывает A-запись DNS этого сервера: Caddy получит для него сертификат.
# Своего домена нет — подойдёт бесплатный вида 203-0-113-10.sslip.io (IP сервера через дефисы).
CARDLESSON_DOMAIN=api.example.com

# Откуда браузеру можно ходить в API: адрес фронтенда без пути, через запятую.
# GitHub Pages: https://orioko.github.io (путь /cardlesson не указывается)
CARDLESSON_ALLOWED_ORIGINS=https://orioko.github.io

# Сколько дней живёт вход
CARDLESSON_SESSION_DAYS=90

# Ежедневные копии базы в data/backups: сколько последних хранить (0 — выключить)
CARDLESSON_BACKUP_KEEP=14

TZ=Europe/Moscow

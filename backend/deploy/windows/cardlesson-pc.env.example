# Настройки сервера CardLesson на домашнем ПК.
# Скопируй в cardlesson-pc.env (рядом со скриптами) и поправь пути. Файл cardlesson-pc.env в git не попадает.

# База и бэкапы — вне папки с репозиторием, чтобы их не задело при git clean/переустановке.
CARDLESSON_DB=G:\cardlesson-data\cardlesson.db
CARDLESSON_BACKUP_DIR=G:\cardlesson-data\backups
CARDLESSON_BACKUP_KEEP=14

# Сервер слушает только этот ПК, снаружи он доступен лишь через туннель.
CARDLESSON_ADDR=127.0.0.1:8080
CARDLESSON_TRUST_PROXY=1
# Сайт на GitHub Pages. Android-приложению Origin не нужен.
CARDLESSON_ALLOWED_ORIGINS=https://orioko.github.io

# Расписание (должно совпадать с shared/constants/serverSchedule.ts): дни 1=пн … 7=вс.
SCHEDULE_DAYS=1,2,3,4,5
SCHEDULE_FROM=10
SCHEDULE_TO=20

# Туннель: tailscale (Tailscale Funnel), cloudflared (именованный туннель Cloudflare) или none.
CARDLESSON_TUNNEL=tailscale
# Для cloudflared: имя туннеля из `cloudflared tunnel create <имя>`.
CLOUDFLARED_TUNNEL_NAME=cardlesson
